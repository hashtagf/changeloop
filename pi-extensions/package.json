{
  "name": "@hashtagf/pi-extensions",
  "version": "0.4.0",
  "description": "Pi extensions: worker agent team with task board, persistent structured user questions, background shell jobs, a 9router provider, session titles that name the current work, a workspace web UI with task board, and Claude account switching.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "ask-user",
    "questionnaire",
    "background-jobs",
    "task-board",
    "9router",
    "provider"
  ],
  "type": "module",
  "license": "MIT",
  "author": "hashtagf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hashtagf/changeloop.git",
    "directory": "pi-extensions"
  },
  "homepage": "https://github.com/hashtagf/changeloop/tree/main/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/hashtagf/changeloop/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "pi": {
    "extensions": [
      "./agent-team/index.ts",
      "./ask-user/index.ts",
      "./background-bash/index.ts",
      "./nine-router/index.ts",
      "./session-title/index.ts",
      "./team-webui/index.ts",
      "./claude-accounts/index.ts"
    ]
  },
  "files": [
    "agent-team/",
    "ask-user/",
    "background-bash/",
    "nine-router/",
    "session-title/",
    "team-webui/",
    "claude-accounts/",
    "!**/*.test.cjs",
    "!**/*.test.mjs",
    "!**/__pycache__/",
    "!team-webui/scripts/",
    "!**/test.cjs",
    "!**/test/",
    "docs/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "bash test.sh && node --test scripts/*.test.cjs",
    "test:tui": "bash test.sh --tui",
    "typecheck": "tsc -p tsconfig.json",
    "build:renderers": "node team-webui/scripts/build-renderers.mjs",
    "docs": "node scripts/tool-docs.mjs --write",
    "docs:check": "node scripts/tool-docs.mjs --check",
    "pack:check": "node scripts/pack-check.mjs",
    "check": "npm run typecheck && npm run docs:check && npm run pack:check && npm test",
    "install:local": "bash install.sh",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^26.6.6",
    "dompurify": "3.4.18",
    "esbuild": "0.28.2",
    "marked": "18.2.0",
    "mermaid": "12.3.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  }
}
